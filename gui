def ventana_proveedores():

    ventana = Toplevel()

    ventana.title("Registro de Proveedores")

    ventana.geometry("750x500")

    ventana.resizable(False, False)

    Label(
        ventana,
        text="REGISTRO DE PROVEEDORES",
        font=("Arial",16,"bold")
    ).grid(row=0,column=0,columnspan=4,pady=15)


    campos = [

        "Tipo Documento",
        "Número Documento",
        "Nombre Proveedor",
        "Ciudad",
        "Dirección",
        "Teléfono",
        "Correo",
        "Representante Legal",
        "Régimen Tributario",
        "RUT",
        "Banco",
        "Tipo Cuenta",
        "Número Cuenta",
        "Tipo Proveedor",
        "Tiempo Entrega (días)",
        "Contacto Comercial",
        "Contacto Cartera",
        "Contacto Logístico",
        "Condiciones Pago (días)",
        "Calificación (1-5)"

    ]


    entradas = []


    fila = 1

    columna = 0


    for campo in campos:

        Label(
            ventana,
            text=campo
        ).grid(
            row=fila,
            column=columna,
            padx=10,
            pady=4,
            sticky="w"
        )

        entrada = Entry(
            ventana,
            width=25
        )

        entrada.grid(
            row=fila,
            column=columna+1,
            padx=5,
            pady=4
        )

        entradas.append(entrada)

        if columna == 0:

            columna = 2

        else:

            columna = 0

            fila += 1


    def guardar():

        proveedor = []

        for entrada in entradas:

            proveedor.append(
                entrada.get()
            )

        registrar_proveedor(proveedor)

        messagebox.showinfo(

            "Proveedor",

            "Proveedor registrado correctamente."

        )

        ventana.destroy()


    Button(

        ventana,

        text="Guardar",

        width=20,

        command=guardar

    ).grid(

        row=fila+1,

        column=0,

        columnspan=4,

        pady=20

    )
