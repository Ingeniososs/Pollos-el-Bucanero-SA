def generar_factura_txt(venta):

    print("Generando factura...")
    codigo = venta[0]
    producto = venta[1]
    cliente = venta[2]
    cantidad = int(venta[3])
    precio = float(venta[4])

    subtotal = cantidad * precio
    iva = subtotal * 0.19
    total = subtotal + iva

    nombre_archivo = os.path.join(
    os.path.dirname(__file__),
    f"factura_{codigo}.txt"
)
    print(nombre_archivo)
    archivo = open(nombre_archivo, "w", encoding="utf-8")

    archivo.write("=========================================\n")
    archivo.write("        POLLOS EL BUCANERO S.A.\n")
    archivo.write("        FACTURA DE VENTA\n")
    archivo.write("=========================================\n\n")

    archivo.write(f"Factura No.: {codigo}\n\n")

    archivo.write("DATOS DEL CLIENTE\n")
    archivo.write("-----------------------------------------\n")
    archivo.write(f"Cliente: {cliente}\n\n")

    archivo.write("DETALLE DE LA FACTURA\n")
    archivo.write("-----------------------------------------\n")
    archivo.write(f"Producto : {producto}\n")
    archivo.write(f"Cantidad : {cantidad}\n")
    archivo.write(f"Precio   : ${precio:,.0f}\n")
    archivo.write(f"Subtotal : ${subtotal:,.0f}\n")
    archivo.write(f"IVA (19%): ${iva:,.0f}\n")
    archivo.write(f"TOTAL    : ${total:,.0f}\n\n")

    archivo.write("Gracias por su compra.\n")
    archivo.write("POLLOS EL BUCANERO S.A.\n")

    archivo.close()
