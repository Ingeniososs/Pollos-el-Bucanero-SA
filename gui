def ventana_inventario():

    ventana = Toplevel()

    ventana.title("Inventario")

    ventana.geometry("520x500")

    ventana.resizable(False,False)

    Label(
        ventana,
        text="REGISTRO DE INVENTARIO",
        font=("Arial",16,"bold")
    ).pack(pady=10)


    if len(proveedores)==0:

        Label(
            ventana,
            text="No hay proveedores registrados."
        ).pack(pady=20)

        return


    Label(
        ventana,
        text="Proveedor"
    ).pack()

    nombres=[]

    for proveedor in proveedores:

        nombres.append(proveedor[2])

    combo_proveedor=Combobox(

        ventana,

        values=nombres,

        state="readonly",

        width=35

    )

    combo_proveedor.pack()


    Label(
        ventana,
        text="Nombre del Insumo"
    ).pack()

    entrada_insumo=Entry(
        ventana,
        width=38
    )

    entrada_insumo.pack()


    Label(
        ventana,
        text="Inventario Actual"
    ).pack()

    entrada_stock=Entry(
        ventana,
        width=38
    )

    entrada_stock.pack()


    Label(
        ventana,
        text="Demanda Diaria"
    ).pack()

    entrada_demanda=Entry(
        ventana,
        width=38
    )

    entrada_demanda.pack()

    def guardar():

        if combo_proveedor.get() == "":

            messagebox.showerror(
                "Error",
                "Seleccione un proveedor."
            )
            return

        try:

            inventario_actual = int(entrada_stock.get())
            demanda_diaria = int(entrada_demanda.get())

        except ValueError:

            messagebox.showerror(
                "Error",
                "Inventario y demanda deben ser números."
            )
            return

        respuesta = registrar_producto(

            combo_proveedor.get(),
            entrada_insumo.get(),
            inventario_actual,
            demanda_diaria

        )

        if respuesta == False:

            messagebox.showerror(
                "Error",
                "El proveedor no existe."
            )

            return

        messagebox.showinfo(
            "Inventario",
            "Producto registrado correctamente."
        )

        combo_proveedor.set("")
        entrada_insumo.delete(0, END)
        entrada_stock.delete(0, END)
        entrada_demanda.delete(0, END)


    Button(

        ventana,

        text="Guardar Producto",

        width=25,

        command=guardar

    ).pack(pady=10)


    Button(

        ventana,

        text="Consultar Inventario",

        width=25,

        command=ventana_consultar_inventario

    ).pack(pady=10)

