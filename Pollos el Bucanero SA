clientes = []
proveedores = []

def registro_clientes():

    print("Registro de Datos del Cliente")

    tipodocu = input("Digite su tipo de documento (CC/NIT/CE): ")
    numerodocu = input("Digite su número de documento: ")
    nombre = input("Digite su nombre: ")
    autorizacion = input("Acepta Habeas Data SI/NO: ")

    if autorizacion != "SI":
        print("No es posible continuar sin autorización")
        return

    ciudad = input("Ciudad: ")
    dir_operativa = input("Dirección operativa: ")
    dir_residencia = input("Direccion residencia: ")
    telefono = input("Teléfono celular: ")
    email = input("E-mail: ")
    reprelegal = input("Representante legal: ")
    regimen = input("Régimen tributario: ")

    cliente = [
        tipodocu,
        numerodocu,
        nombre,
        autorizacion,
        ciudad,
        dir_operativa,
        dir_residencia,
        telefono,
        email,
        reprelegal,
        regimen
    ]

    clientes.append(cliente)

    print("Cliente registrado correctamente")


def registro_proveedores():

    print("Registro de datos del proveedor")

    tipodocu = input("Digite su tipo de documento (CC/NIT/CE): ")
    numerodocu = input("Digite su número de documento: ")
    nombre = input("Digite el nombre o razón social: ")

    autorizacion = input("Acepta Habeas Data SI/NO: ")

    if autorizacion != "SI":
        print("No es posible continuar sin autorización")
        return

    ciudad = input("Ciudad: ")
    dir_operativa = input("Dirección operativa: ")
    dir_residencia = input("Dirección residencia: ")
    telefono = input("Teléfono celular: ")
    email = input("E-mail: ")
    reprelegal = input("Representante legal: ")
    regimen = input("Régimen tributario: ")

    rut = input("Número del RUT: ")

    banco = input("Banco: ")
    tipo_cuenta = input("Tipo de cuenta: ")
    numero_cuenta = input("Número de cuenta: ")

    tipo_proveedor = input("Tipo de proveedor: ")

    tiempo_entrega = int(input("Tiempo de entrega promedio (días): "))

    contacto_comercial = input("Contacto comercial: ")
    contacto_cartera = input("Contacto cartera/pagos: ")
    contacto_logistico = input("Contacto logístico: ")

    condiciones_pago = int(input("Condiciones de pago (días): "))

    calificacion = int(input("Calificación (1 a 5): "))

    while calificacion < 1 or calificacion > 5:
        calificacion = int(input("Ingrese una calificación válida (1 a 5): "))

    proveedor = [
        tipodocu,
        numerodocu,
        nombre,
        autorizacion,
        ciudad,
        dir_operativa,
        dir_residencia,
        telefono,
        email,
        reprelegal,
        regimen,
        rut,
        banco,
        tipo_cuenta,
        numero_cuenta,
        tipo_proveedor,
        tiempo_entrega,
        contacto_comercial,
        contacto_cartera,
        contacto_logistico,
        condiciones_pago,
        calificacion
    ]

    proveedores.append(proveedor)

    print("Proveedor registrado correctamente")
    
