# INVENTARIO
# ==========================================

def registrar_producto(

    proveedor,

    insumo,

    inventario_actual,

    demanda_diaria

):

    dias_stock = inventario_actual / demanda_diaria

    if dias_stock < 5:

        estado = "CRITICO"

        accion = "Pedido de Emergencia"

    elif dias_stock <= 15:

        estado = "ALERTA"

        accion = "Realizar Pedido Normal"

    else:

        estado = "SEGURO"

        accion = "Mantener Monitoreo"

    producto = [

        proveedor,

        insumo,

        inventario_actual,

        demanda_diaria,

        dias_stock,

        estado,

        accion

    ]

    inventario.append(producto)


def mostrar_inventario():

    return inventario

